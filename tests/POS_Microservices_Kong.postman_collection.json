{
  "info": {
    "name": "POS Microservices API - Kong Gateway",
    "description": "Collection complète pour tester les microservices via Kong API Gateway",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "kong_gateway_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "kong_admin_url", 
      "value": "http://localhost:8001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🐒 Kong Administration",
      "item": [
        {
          "name": "Kong Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{kong_admin_url}}/status",
              "host": ["{{kong_admin_url}}"],
              "path": ["status"]
            }
          }
        },
        {
          "name": "List Services",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{kong_admin_url}}/services",
              "host": ["{{kong_admin_url}}"],
              "path": ["services"]
            }
          }
        },
        {
          "name": "List Upstreams",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{kong_admin_url}}/upstreams",
              "host": ["{{kong_admin_url}}"],
              "path": ["upstreams"]
            }
          }
        },
        {
          "name": "Kong Metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{kong_admin_url}}/metrics",
              "host": ["{{kong_admin_url}}"],
              "path": ["metrics"]
            }
          }
        }
      ]
    },
    {
      "name": "🛍️ Produit Service",
      "item": [
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Kong-Request-ID",
                "value": "postman-test-{{$randomUUID}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{kong_gateway_url}}/api/produits",
              "host": ["{{kong_gateway_url}}"],
              "path": ["api", "produits"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is array', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Kong headers present', function () {",
                  "    pm.expect(pm.response.headers.get('X-Kong-Proxy-Latency')).to.exist;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{kong_gateway_url}}/api/produits/1",
              "host": ["{{kong_gateway_url}}"],
              "path": ["api", "produits", "1"]
            }
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Produit Test Postman\",\n  \"description\": \"Créé via Postman\",\n  \"prix\": 29.99,\n  \"categorieId\": 1\n}"
            },
            "url": {
              "raw": "{{kong_gateway_url}}/api/produits",
              "host": ["{{kong_gateway_url}}"],
              "path": ["api", "produits"]
            }
          }
        },
        {
          "name": "Product Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{kong_gateway_url}}/api/produits/health",
              "host": ["{{kong_gateway_url}}"],
              "path": ["api", "produits", "health"]
            }
          }
        }
      ]
    },
    {
      "name": "📦 Stock Service",
      "item": [
        {
          "name": "Get Stock Overview",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{kong_gateway_url}}/api/stock",
              "host": ["{{kong_gateway_url}}"],
              "path": ["api", "stock"]
            }
          }
        },
        {
          "name": "Get Stock by Product",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{kong_gateway_url}}/api/stock/produit/1",
              "host": ["{{kong_gateway_url}}"],
              "path": ["api", "stock", "produit", "1"]
            }
          }
        },
        {
          "name": "Update Stock",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantite\": 100,\n  \"magasinId\": 1\n}"
            },
            "url": {
              "raw": "{{kong_gateway_url}}/api/stock/produit/1",
              "host": ["{{kong_gateway_url}}"],
              "path": ["api", "stock", "produit", "1"]
            }
          }
        },
        {
          "name": "Stock Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{kong_gateway_url}}/api/stock/health",
              "host": ["{{kong_gateway_url}}"],
              "path": ["api", "stock", "health"]
            }
          }
        }
      ]
    },
    {
      "name": "💰 Vente Service",
      "item": [
        {
          "name": "Get All Sales",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{kong_gateway_url}}/api/ventes",
              "host": ["{{kong_gateway_url}}"],
              "path": ["api", "ventes"]
            }
          }
        },
        {
          "name": "Create Sale",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"magasinId\": 1,\n  \"utilisateurId\": 1,\n  \"lignes\": [\n    {\n      \"produitId\": 1,\n      \"quantite\": 2,\n      \"prixUnitaire\": 15.99\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{kong_gateway_url}}/api/ventes",
              "host": ["{{kong_gateway_url}}"],
              "path": ["api", "ventes"]
            }
          }
        },
        {
          "name": "Get Sale by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{kong_gateway_url}}/api/ventes/1",
              "host": ["{{kong_gateway_url}}"],
              "path": ["api", "ventes", "1"]
            }
          }
        },
        {
          "name": "Complete Sale",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"statut\": \"terminee\"\n}"
            },
            "url": {
              "raw": "{{kong_gateway_url}}/api/ventes/1/statut",
              "host": ["{{kong_gateway_url}}"],
              "path": ["api", "ventes", "1", "statut"]
            }
          }
        },
        {
          "name": "Vente Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{kong_gateway_url}}/api/ventes/health",
              "host": ["{{kong_gateway_url}}"],
              "path": ["api", "ventes", "health"]
            }
          }
        }
      ]
    },
    {
      "name": "📊 Reporting Service",
      "item": [
        {
          "name": "Get All Reports",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{kong_gateway_url}}/api/rapports",
              "host": ["{{kong_gateway_url}}"],
              "path": ["api", "rapports"]
            }
          }
        },
        {
          "name": "Daily Sales Report",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{kong_gateway_url}}/api/rapports/ventes/daily",
              "host": ["{{kong_gateway_url}}"],
              "path": ["api", "rapports", "ventes", "daily"]
            }
          }
        },
        {
          "name": "Stock Alert Report",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{kong_gateway_url}}/api/rapports/stock/alerts",
              "host": ["{{kong_gateway_url}}"],
              "path": ["api", "rapports", "stock", "alerts"]
            }
          }
        },
        {
          "name": "Generate Custom Report",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"ventes\",\n  \"dateDebut\": \"2025-01-01\",\n  \"dateFin\": \"2025-01-31\",\n  \"magasinId\": 1\n}"
            },
            "url": {
              "raw": "{{kong_gateway_url}}/api/rapports/generate",
              "host": ["{{kong_gateway_url}}"],
              "path": ["api", "rapports", "generate"]
            }
          }
        },
        {
          "name": "Reporting Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{kong_gateway_url}}/api/rapports/health",
              "host": ["{{kong_gateway_url}}"],
              "path": ["api", "rapports", "health"]
            }
          }
        }
      ]
    },
    {
      "name": "🔄 Load Balancing Tests",
      "item": [
        {
          "name": "Test Load Balancing - Multiple Requests",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Response time under 500ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});",
                  "",
                  "pm.test('Kong load balancing headers', function () {",
                  "    pm.expect(pm.response.headers.get('X-Kong-Upstream-Latency')).to.exist;",
                  "});",
                  "",
                  "// Store response time for analysis",
                  "pm.globals.set('response_time_' + pm.info.iterationCount, pm.response.responseTime);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Test-Iteration",
                "value": "{{$randomInt}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{kong_gateway_url}}/api/produits",
              "host": ["{{kong_gateway_url}}"],
              "path": ["api", "produits"]
            }
          }
        }
      ]
    },
    {
      "name": "📈 Monitoring & Metrics",
      "item": [
        {
          "name": "Prometheus Metrics - Kong",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{kong_admin_url}}/metrics",
              "host": ["{{kong_admin_url}}"],
              "path": ["metrics"]
            }
          }
        },
        {
          "name": "Health Check All Services",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('All services healthy', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('healthy');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{kong_gateway_url}}/health",
              "host": ["{{kong_gateway_url}}"],
              "path": ["health"]
            }
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global pre-request script",
          "console.log('Testing via Kong Gateway on port 8000');"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global test script",
          "pm.test('Response has Kong headers', function () {",
          "    pm.expect(pm.response.headers.get('Via')).to.include('kong');",
          "});"
        ]
      }
    }
  ]
}
