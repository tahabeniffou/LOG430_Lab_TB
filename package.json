{
  "name": "pos-microservices-system",
  "version": "1.7.1",
  "description": "Système POS avec architecture microservices - Labs 6 & 7",
  "main": "app/app.js",
  "scripts": {
    "start": "docker-compose up -d",
    "stop": "docker-compose down",
    "restart": "npm run stop && npm run start",
    "build": "docker-compose build",
    "logs": "docker-compose logs -f",
    "status": "docker-compose ps",
    "test": "cd tests && npm test",
    "test:saga": "cd tests && node saga-choreography-test.js",
    "test:saga-orchestrator": "cd tests && node saga-orchestrator-test.js",
    "test:k6-saga": "k6 run tests/k6-saga-orchestrator-load-test.js",
    "test:workflow": "cd tests && node test-workflow.js",
    "test:microservices": "cd tests && node test-microservices-workflow.js",
    "test:ecommerce": "cd tests && node test-ecommerce-workflow.js",
    "test:k6": "k6 run tests/k6-load-test.js",
    "config:kong": "cd config && bash kong-config.sh",
    "setup": "npm run build && npm run config:kong && npm run start",
    "health": "node health-check.js",
    "console": "node consoles/console-maison-mere.js",
    "deploy:lab6": "docker-compose -f docker-compose.yml up -d",
    "deploy:lab7": "docker-compose -f docker-compose-lab7.yml up -d",
    "deploy:unified": "docker-compose -f docker-compose-unified.yml up -d",
    "clean": "docker-compose down -v && docker system prune -f"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tahabeniffou/LOG430_Lab_TB.git"
  },
  "keywords": [
    "microservices",
    "pos",
    "saga",
    "event-driven",
    "docker",
    "kong",
    "rabbitmq",
    "postgresql",
    "prometheus",
    "grafana"
  ],
  "author": "Taha Beniffou",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.0",
    "axios": "^1.6.0",
    "chalk": "^4.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "helmet": "^6.0.0",
    "winston": "^3.8.0",
    "prom-client": "^14.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "jest": "^29.0.0",
    "eslint": "^8.0.0",
    "nodemon": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
