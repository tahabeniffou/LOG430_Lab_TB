@startuml Architecture_Complete_Flow_Detaillee
!theme plain
title Architecture Hybride Complète - Flow des Requêtes par Console

skinparam backgroundColor #f8f9fa
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam noteStyle floating

!define LIGHTBLUE #e3f2fd
!define LIGHTGREEN #e8f5e8
!define LIGHTYELLOW #fff8e1
!define LIGHTRED #ffebee
!define LIGHTGRAY #f5f5f5
!define LIGHTPURPLE #f3e5f5
!define LIGHTORANGE #fff3e0
!define LIGHTCYAN #e0f7fa

' === STRUCTURE PRINCIPALE ===

package "CLIENTS & CONSOLES" as Clients #LIGHTYELLOW {
  
  package "Console POS" as POSConsole {
    actor "Terminal POS" as POS {
      [Vente Produits]
      [Gestion Stock]
      [Transactions]
    }
  }
  
  package "Console Maison Mère" as MaisonMereConsole {
    actor "Manager HQ" as MaisonMere {
      [Reporting]
      [Gestion Globale]
      [Analytics]
    }
  }
  
  package "Applications Modernes" as ModernApps {
    actor "Web App" as WebApp
    actor "Mobile App" as MobileApp
    actor "API Client" as APIClient
  }
}

package "GATEWAY & ROUTING LAYER" as GatewayLayer #LIGHTBLUE {
  
  component "Kong API Gateway\n:8001" as Kong {
    [Rate Limiting: 200/min]
    [CORS Management]
    [Authentication]
    [Request Logging]
  }
  
  component "Hybrid Router\n:9000" as Router {
    [Client Detection]
    [Route Analysis]
    [Service Selection]
    [Request Proxy]
  }
  
  component "Load Balancer\n:8000" as LoadBalancer {
    [Round-Robin]
    [Health Checks]
    [Failover]
  }
}

package "SYSTEME DE BASE (LEGACY)" as LegacySystem #LIGHTORANGE {
  
  component "Legacy App\n:3000" as LegacyApp {
    [Magasin Management]
    [User Authentication]
    [Session Management]
    [Vente Processing]
    [Basic Reports]
  }
  
  note right of LegacyApp
    **Gère pour POS:**
    ✅ Authentification utilisateur
    ✅ Gestion des ventes
    ✅ Gestion des produits (CRUD)
    ✅ Sessions utilisateur
    
    **Gère pour Maison Mère:**
    ✅ Gestion des magasins
    ✅ Gestion des utilisateurs
    ✅ Ventes consolidées
    ✅ Rapports basiques
  end note
}

package "MICROSERVICES LAYER" as MicroservicesLayer #LIGHTGREEN {
  
  package "Produit Service Cluster" as ProduitCluster {
    component "Produit-1\n:3001" as Produit1
    component "Produit-2\n:3005" as Produit2  
    component "Produit-3\n:3006" as Produit3
  }
  
  component "Vente Service\n:3004" as VenteMS {
    [Order Processing]
    [Business Logic]
    [Validation Rules]
    [Integration APIs]
  }
  
  component "Stock Service\n:3007" as StockMS {
    [Real-time Inventory]
    [Stock Movements]
    [Threshold Alerts]
    [Auto-replenishment]
  }
  
  component "Reporting Service\n:3008" as ReportingMS {
    [Advanced Analytics]
    [Data Aggregation]
    [Custom Reports]
    [KPI Dashboards]
  }
  
  note right of StockMS
    **Gère pour POS:**
    ✅ Stock temps réel
    ✅ Vérification disponibilité
    ✅ Ajustements automatiques
    ✅ Alertes de rupture
  end note
  
  note right of ReportingMS
    **Gère pour Maison Mère:**
    ✅ Rapports avancés
    ✅ Analytics multi-magasins
    ✅ Métriques business
    ✅ Tableaux de bord
  end note
}

package "DATA LAYER" as DataLayer #LIGHTRED {
  
  database "PostgreSQL\n:5433\nProduits" as PostgresDB {
    [Tables Produits]
    [Categories]
    [Prix History]
  }
  
  database "MySQL Principal\n:3306\nMain DB" as MySQLDB {
    [Legacy Tables:]
    [- magasins]
    [- utilisateurs] 
    [- sessions]
    [Shared Tables:]
    [- ventes]
    [- stock_movements]
    [- reports_cache]
  }
  
  component "Redis Cache\n:6379" as Redis {
    [Sessions Cache]
    [Report Cache]
    [Temp Data]
  }
}

package "MONITORING & TOOLS" as MonitoringLayer #LIGHTGRAY {
  component "Prometheus\n:9090" as Prometheus {
    [Metrics Collection]
    [Service Health]
    [Performance Data]
  }
  
  component "Grafana\n:3333" as Grafana {
    [Dashboards]
    [Alerts]
    [Visualization]
  }
}

' === FLOW DES REQUETES POS ===

note as POSFlow
  **FLOW CONSOLE POS**
  
  **1. Authentification:** POS → Legacy
  **2. Gestion Produits:** POS → Legacy  
  **3. Vérif Stock:** POS → Stock μService
  **4. Création Vente:** POS → Legacy
  **5. Maj Stock:** Legacy → Stock μService
end note

' === FLOW DES REQUETES MAISON MERE ===

note as MaisonMereFlow
  **FLOW CONSOLE MAISON MÈRE**
  
  **1. Auth Manager:** MM → Legacy
  **2. Gestion Magasins:** MM → Legacy
  **3. Rapports Simples:** MM → Legacy
  **4. Analytics Avancées:** MM → Reporting μService
  **5. Vues Consolidées:** MM → Legacy + μServices
end note

' === FLOW DES REQUETES API MODERNE ===

note as ModernFlow
  **FLOW APPLICATIONS MODERNES**
  
  **1. Produits:** API → Produit μService
  **2. Ventes:** API → Vente μService  
  **3. Stock:** API → Stock μService
  **4. Reports:** API → Reporting μService
  **5. Full μServices:** Pas de Legacy
end note

' === CONNEXIONS PRINCIPALES ===

' Clients vers Gateway
POS --> Kong : "X-Client-Type: pos\n/pos/*"
MaisonMere --> Kong : "X-Client-Type: maisonmere\n/maisonmere/*"
WebApp --> Kong : "/api/v2/*"
MobileApp --> Kong : "/api/v2/*"
APIClient --> Kong : "/api/v1/* ou /api/v2/*"

' Gateway vers Router
Kong --> Router : "Route Analysis"

' Router Logic - POS
Router --> LegacyApp : "/pos/produits\n/pos/ventes\n/pos/auth"
Router --> StockMS : "/pos/stock\n/pos/inventory"

' Router Logic - Maison Mère  
Router --> LegacyApp : "/maisonmere/magasins\n/maisonmere/users\n/maisonmere/ventes"
Router --> ReportingMS : "/maisonmere/reports\n/maisonmere/analytics"

' Router Logic - API Moderne
Router --> Produit1 : "/api/v2/produits"
Router --> VenteMS : "/api/v2/ventes"
Router --> StockMS : "/api/v2/stocks"
Router --> ReportingMS : "/api/v2/reports"

' Router Logic - API Legacy
Router --> LegacyApp : "/api/v1/*"

' Load Balancer
LoadBalancer --> Produit1 : "Round-Robin"
LoadBalancer --> Produit2 : "Round-Robin"
LoadBalancer --> Produit3 : "Round-Robin"

' Database Connections
LegacyApp --> MySQLDB : "Legacy + Shared Tables"
VenteMS --> MySQLDB : "Ventes Tables"
StockMS --> MySQLDB : "Stock Tables"
ReportingMS --> MySQLDB : "Aggregation Queries"

Produit1 --> PostgresDB : "Isolated Produit DB"
Produit2 --> PostgresDB : "Isolated Produit DB"
Produit3 --> PostgresDB : "Isolated Produit DB"

' Cache Connections
LegacyApp --> Redis : "User Sessions"
ReportingMS --> Redis : "Report Cache"
VenteMS --> Redis : "Temp Cart Data"

' Inter-Service Communication
VenteMS ..> Produit1 : "Product Validation"
VenteMS ..> StockMS : "Stock Updates"
LegacyApp ..> StockMS : "Stock Sync"
ReportingMS ..> VenteMS : "Sales Data"
ReportingMS ..> StockMS : "Inventory Data"
ReportingMS ..> LegacyApp : "Legacy Data"

' Monitoring
LegacyApp --> Prometheus : "Legacy Metrics"
Router --> Prometheus : "Router Metrics" 
Produit1 --> Prometheus : "Service Metrics"
Produit2 --> Prometheus : "Service Metrics"
Produit3 --> Prometheus : "Service Metrics"
VenteMS --> Prometheus : "Service Metrics"
StockMS --> Prometheus : "Service Metrics"
ReportingMS --> Prometheus : "Service Metrics"

Prometheus --> Grafana : "Data Source"

' === POSITIONING DES NOTES ===
POSFlow -[hidden]-> POSConsole
MaisonMereFlow -[hidden]-> MaisonMereConsole  
ModernFlow -[hidden]-> ModernApps

' === LEGENDE DETAILLEE ===

legend bottom
  **ROUTING LOGIC SUMMARY**
  
  |= Console |= Route Pattern |= Destination |= Raison |
  | 📺 **POS** | /pos/produits, /pos/ventes | → Legacy System | Compatibilité existante |
  | 📺 **POS** | /pos/stock, /pos/inventory | → Stock μService | Stock temps réel |
  | 🏢 **Maison Mère** | /maisonmere/magasins, /maisonmere/users | → Legacy System | Gestion centralisée |
  | 🏢 **Maison Mère** | /maisonmere/reports, /maisonmere/analytics | → Reporting μService | Analytics avancées |
  | 🚀 **API v2** | /api/v2/* | → Microservices | Architecture moderne |
  | 🔄 **API v1** | /api/v1/* | → Legacy System | Rétrocompatibilité |
  
  **MICROSERVICES RESPONSIBILITIES**
  
  |= Service |= Responsabilités POS |= Responsabilités Maison Mère |
  | **Produit** | ❌ (via Legacy) | ❌ (via Legacy) |
  | **Vente** | ❌ (via Legacy) | ❌ (via Legacy) |
  | **Stock** | ✅ Stock temps réel | ❌ (via Legacy) |
  | **Reporting** | ❌ | ✅ Analytics avancées |
  
  **PORTS & ACCESS POINTS**
  • Kong Gateway: :8001 • Hybrid Router: :9000 • Legacy System: :3000
  • Load Balancer: :8000 • Prometheus: :9090 • Grafana: :3333
endlegend

@enduml
