	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Ajouter timestamp pour les tests",
					"pm.globals.set('timestamp', new Date().toISOString());"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript", 
				"exec": [
					"// Tests automatiques pour tous les appels",
					"pm.test('Status code is successful', function () {",
					"    pm.expect(pm.response.code).to.be.oneOf([200, 201, 204]);",
					"});",
					"",
					"pm.test('Response time is less than 2000ms', function () {",
					"    pm.expect(pm.response.responseTime).to.be.below(2000);",
					"});",
					"",
					"pm.test('Content-Type header is present', function () {",
					"    pm.expect(pm.response.headers.get('Content-Type')).to.exist;",
					"});",
					"",
					"// Vérifier les headers de sécurité Kong",
					"pm.test('Kong Gateway headers present', function () {",
					"    const gatewayHeader = pm.response.headers.get('X-Gateway');",
					"    if (gatewayHeader) {",
					"        pm.expect(gatewayHeader).to.include('Kong');",
					"    }",
					"});",
					"",
					"// Logger les métriques pour analyse",
					"console.log('Response Time:', pm.response.responseTime + 'ms');",
					"console.log('Response Size:', pm.response.responseSize + ' bytes');"
				]
			}
		}
	]
