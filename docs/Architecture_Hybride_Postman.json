	"item": [
		{
			"name": "🏪 Console POS",
			"description": "Tests pour la console Point de Vente",
			"item": [
				{
					"name": "Lister produits (Legacy)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-Client-Type",
								"value": "pos",
								"type": "text"
							},
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{gateway_url}}/pos/produits?search=iPhone",
							"host": ["{{gateway_url}}"],
							"path": ["pos", "produits"],
							"query": [
								{
									"key": "search",
									"value": "iPhone"
								}
							]
						},
						"description": "Récupère les produits via le système legacy"
					}
				},
				{
					"name": "Vérifier stock (Microservice)",
					"request": {
						"method": "GET",
						"header": [
