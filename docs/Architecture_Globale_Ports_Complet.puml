@startuml Architecture_Globale_Ports_Complet
!theme plain
title Architecture Hybride Complète - Ports et Connexions

skinparam backgroundColor #f8f9fa
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam linetype ortho

!define LEGACY #FF9800
!define MICROSERVICE #4CAF50
!define GATEWAY #2196F3
!define DATABASE #F44336
!define MONITORING #9E9E9E
!define CACHE #795548

' === SECTION CLIENTS ===
rectangle "CLIENTS & CONSOLES" as ClientZone #FFFDE7 {
  rectangle "📺 Console POS\n(Terminaux de vente)" as POS
  rectangle "🏢 Console Maison Mère\n(Gestion centralisée)" as MM  
  rectangle "🌐 Applications Web\n(Interface moderne)" as WEB
  rectangle "📱 Applications Mobile\n(Apps natives)" as MOBILE
  rectangle "🔧 API Clients\n(Postman, Tests)" as API
}

' === SECTION GATEWAY ===
rectangle "GATEWAY & LOAD BALANCING" as GatewayZone #E3F2FD {
  rectangle "🌉 Kong API Gateway\n:8001 (Proxy)\n:8002 (Admin)" as KONG #GATEWAY
  rectangle "🔀 Hybrid Router\n:9000\n(Routage Intelligent)" as ROUTER #GATEWAY
  rectangle "⚖️ Load Balancer\n:8000\n(Round-Robin)" as LB #GATEWAY
}

' === SECTION LEGACY ===
rectangle "SYSTÈME DE BASE (LEGACY)" as LegacyZone #FFF3E0 {
  rectangle "🏛️ Legacy System\n:3000\n[Express + MySQL]" as LEGACY #LEGACY
}

' === SECTION MICROSERVICES ===
rectangle "MICROSERVICES ESSENTIELS" as MicroZone #E8F5E8 {
  rectangle "🛍️ Produit Service 1\n:3001\n[Express + PostgreSQL]" as PROD1 #MICROSERVICE
  rectangle "🛍️ Produit Service 2\n:3005\n[Express + PostgreSQL]" as PROD2 #MICROSERVICE
  rectangle "🛍️ Produit Service 3\n:3006\n[Express + PostgreSQL]" as PROD3 #MICROSERVICE
  rectangle "💰 Vente Service\n:3004\n[Express + MySQL]" as VENTE #MICROSERVICE
  rectangle "📦 Stock Service\n:3007\n[Express + MySQL]" as STOCK #MICROSERVICE
  rectangle "📊 Reporting Service\n:3008\n[Express + MySQL + Redis]" as REPORT #MICROSERVICE
}

' === SECTION DATABASES ===
rectangle "BASES DE DONNÉES" as DBZone #FFEBEE {
  rectangle "🐘 PostgreSQL\n:5433\nproduit_service" as POSTGRES #DATABASE
  rectangle "🐬 MySQL Principal\n:3306\nmain_db" as MYSQL #DATABASE
  rectangle "🗄️ Redis Cache\n:6379\nSessions + Cache" as REDIS #CACHE
}

' === SECTION MONITORING ===
rectangle "MONITORING & TOOLS" as MonitorZone #F5F5F5 {
  rectangle "📊 Prometheus\n:9090\nMétriques" as PROMETHEUS #MONITORING
  rectangle "📈 Grafana\n:3333\nDashboards" as GRAFANA #MONITORING
}

' === CONNEXIONS CLIENTS ===
POS --> KONG : "X-Client-Type: pos"
MM --> KONG : "X-Client-Type: maisonmere"
WEB --> KONG : "Web requests"
MOBILE --> KONG : "Mobile API"
API --> KONG : "REST API calls"

' === GATEWAY ROUTING ===
KONG --> ROUTER : "Route analysis\nAll requests"
KONG --> LB : "Direct LB access\n/loadbalancer/*"

' === HYBRID ROUTER LOGIC ===
ROUTER --> LEGACY : "POS: /pos/produits, /pos/ventes\nMM: /maisonmere/magasins\nAPI v1: /api/v1/*"
ROUTER --> STOCK : "POS: /pos/stock/*"
ROUTER --> REPORT : "MM: /maisonmere/reports/*"
ROUTER --> PROD1 : "API v2: /api/v2/produits/*"
ROUTER --> VENTE : "API v2: /api/v2/ventes/*"
ROUTER --> STOCK : "API v2: /api/v2/stocks/*"
ROUTER --> REPORT : "API v2: /api/v2/reports/*"

' === LOAD BALANCER ===
LB --> PROD1 : "Round-robin\nHealth checks"
LB --> PROD2 : "Round-robin\nHealth checks"
LB --> PROD3 : "Round-robin\nHealth checks"

' === DATABASE CONNECTIONS ===
LEGACY --> MYSQL : "Legacy tables:\nmagasins, utilisateurs, sessions"
VENTE --> MYSQL : "Shared tables:\nventes, vente_details"
STOCK --> MYSQL : "Stock tables:\nstocks, mouvements_stock"
REPORT --> MYSQL : "Analytics tables:\nrapports_cache, metriques"

PROD1 --> POSTGRES : "Isolated DB:\nproduits, categories"
PROD2 --> POSTGRES : "Isolated DB:\nproduits, categories"
PROD3 --> POSTGRES : "Isolated DB:\nproduits, categories"

' === CACHE CONNECTIONS ===
LEGACY --> REDIS : "User sessions\nTemp data"
REPORT --> REDIS : "Report cache\nTTL: 1h"
VENTE --> REDIS : "Cart data\nTemp storage"

' === INTER-SERVICE COMMUNICATION ===
VENTE -.-> PROD1 : "Product validation\nHTTP/REST"
VENTE -.-> STOCK : "Stock updates\nHTTP/REST"
LEGACY -.-> STOCK : "Stock sync\nHTTP/REST"
REPORT -.-> VENTE : "Sales data\nHTTP/REST"
REPORT -.-> STOCK : "Inventory data\nHTTP/REST"
REPORT -.-> LEGACY : "Legacy data\nHTTP/REST"

' === MONITORING CONNECTIONS ===
LEGACY --> PROMETHEUS : "Legacy metrics\n/metrics"
ROUTER --> PROMETHEUS : "Router metrics\n/metrics"
PROD1 --> PROMETHEUS : "Service metrics\n/metrics"
PROD2 --> PROMETHEUS : "Service metrics\n/metrics"
PROD3 --> PROMETHEUS : "Service metrics\n/metrics"
VENTE --> PROMETHEUS : "Service metrics\n/metrics"
STOCK --> PROMETHEUS : "Service metrics\n/metrics"
REPORT --> PROMETHEUS : "Service metrics\n/metrics"
LB --> PROMETHEUS : "LB metrics\n/metrics"
KONG --> PROMETHEUS : "Gateway metrics\n/metrics"

PROMETHEUS --> GRAFANA : "Time series data\nHTTP API"

' === NOTES DÉTAILLÉES ===

note top of ClientZone
  **TYPES DE CLIENTS**
  
  📺 **Console POS:** Vente directe, caisse
  🏢 **Maison Mère:** Gestion, rapports
  🌐 **Web:** Interface moderne
  📱 **Mobile:** Apps natives
  🔧 **API:** Tests, intégrations
end note

note top of GatewayZone
  **GATEWAY LAYER**
  
  🌉 **Kong:** Rate limiting, Auth, CORS
  🔀 **Router:** Intelligence de routage
  ⚖️ **LB:** Distribution produits
end note

note right of ROUTER
  **LOGIQUE DE ROUTAGE**
  
  📺 **POS Routes:**
  • /pos/produits → Legacy
  • /pos/ventes → Legacy  
  • /pos/stock → Stock μS
  
  🏢 **MM Routes:**
  • /maisonmere/magasins → Legacy
  • /maisonmere/reports → Report μS
  
  🚀 **API v2:** → Tous μServices
  🔄 **API v1:** → Legacy only
end note

note bottom of DBZone
  **STRATÉGIE DE DONNÉES**
  
  🐘 **PostgreSQL:** Produits isolés
  🐬 **MySQL:** Legacy + μServices partagé
  🗄️ **Redis:** Cache + Sessions
  
  **Tables par service:**
  • Legacy: magasins, users, sessions
  • Shared: ventes, stocks, reports
  • Produit: catalogue isolé
end note

note bottom of MicroZone
  **RESPONSABILITÉS μSERVICES**
  
  🛍️ **Produit:** Catalogue moderne, API REST
  💰 **Vente:** Logic métier, workflows
  📦 **Stock:** Temps réel, alertes, POS
  📊 **Reporting:** Analytics, MM, dashboards
end note

' === LÉGENDE COMPLÈTE ===
legend bottom left
  **PORTS & ACCÈS**
  |= Service |= Port |= Usage |
  | Kong Gateway | :8001 | Proxy principal |
  | Kong Admin | :8002 | Administration |
  | Hybrid Router | :9000 | Routage intelligent |
  | Load Balancer | :8000 | Distribution produits |
  | Legacy System | :3000 | Système de base |
  | Produit Services | :3001,:3005,:3006 | Load balanced |
  | Vente Service | :3004 | Gestion ventes |
  | Stock Service | :3007 | Inventaire temps réel |
  | Reporting Service | :3008 | Analytics avancées |
  | PostgreSQL | :5433 | DB Produits |
  | MySQL | :3306 | DB Principale |
  | Redis | :6379 | Cache & Sessions |
  | Prometheus | :9090 | Métriques |
  | Grafana | :3333 | Dashboards |
  
  **CODES COULEUR**
  • Orange: Legacy System
  • Vert: Microservices  
  • Bleu: Gateway & LB
  • Rouge: Bases de données
  • Gris: Monitoring
endlegend

@enduml
