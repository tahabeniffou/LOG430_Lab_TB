@startuml Architecture_Hybride_Complete
!theme plain
title Architecture Hybride - Système de Base + Microservices

skinparam backgroundColor #f8f9fa
skinparam componentStyle rectangle
skinparam packageStyle rectangle

!define LIGHTBLUE #e3f2fd
!define LIGHTGREEN #e8f5e8
!define LIGHTYELLOW #fff8e1
!define LIGHTRED #ffebee
!define LIGHTGRAY #f5f5f5
!define LIGHTPURPLE #f3e5f5
!define LIGHTORANGE #fff3e0

package "Clients" as ClientLayer #LIGHTYELLOW {
  actor "Console POS" as POSClient
  actor "Console Maison Mère" as MaisonMereClient
  actor "Application Web" as WebClient
  actor "API Tests/Postman" as APIClient
}

package "API Gateway & Load Balancing" as GatewayLayer #LIGHTBLUE {
  component "Kong API Gateway\n:8001" as Kong {
    [Rate Limiting]
    [Authentication]
    [CORS]
    [Routing Rules]
  }
  
  component "Simple Load Balancer\n:8000" as SimpleLB {
    [Round-Robin]
    [Health Check]
    [Produit Services]
  }
}

package "Routeur Hybride Intelligent" as RouterLayer #LIGHTPURPLE {
  component "Hybrid Router\n:9000" as HybridRouter {
    [Client Detection]
    [Route Decision]
    [Service Proxy]
    [Logging]
  }
}

package "Système de Base (Legacy)" as LegacyLayer #LIGHTORANGE {
  component "Legacy System\n:3000" as LegacySystem {
    [Magasin Management]
    [User Management]
    [Vente Legacy Logic]
    [Session Management]
    [Express API]
  }
}

package "Microservices Essentiels" as MicroservicesLayer #LIGHTGREEN {
  
  package "Produit Service Cluster" as ProduitCluster {
    component "Produit Instance 1\n:3001" as Produit1 {
      [Express API]
      [Product Domain]
      [Repository]
    }
    
    component "Produit Instance 2\n:3005" as Produit2 {
      [Express API]
      [Product Domain]
      [Repository]
    }
    
    component "Produit Instance 3\n:3006" as Produit3 {
      [Express API]
      [Product Domain]
      [Repository]
    }
  }
  
  component "Vente Service\n:3004" as VenteService {
    [Express API]
    [Sales Logic]
    [Business Rules]
    [Integration Layer]
  }
  
  component "Stock Service\n:3007" as StockService {
    [Express API]
    [Inventory Management]
    [Real-time Updates]
    [Threshold Alerts]
  }
  
  component "Reporting Service\n:3008" as ReportingService {
    [Express API]
    [Data Aggregation]
    [Advanced Analytics]
    [Report Generation]
  }
}

package "Base de Données" as DatabaseLayer #LIGHTRED {
  database "PostgreSQL\n:5433" as ProduitDB {
    [produit_service]
    [produits]
    [categories]
  }
  
  database "MySQL Principal\n:3306" as MainDB {
    [Tables Legacy:]
    [magasins, utilisateurs]
    [sessions]
    [Tables Partagées:]
    [ventes, stocks]
    [rapports_cache]
  }
}

package "Infrastructure" as InfraLayer #LIGHTGRAY {
  component "Redis Cache\n:6379" as Redis
  component "Prometheus\n:9090" as Prometheus
  component "Grafana\n:3333" as Grafana
}

' === CONNEXIONS CLIENTS ===
POSClient --> Kong : "X-Client-Type: pos"
MaisonMereClient --> Kong : "X-Client-Type: maisonmere"
WebClient --> Kong : "Web Requests"
APIClient --> Kong : "API Calls"

' === GATEWAY ROUTING ===
Kong --> HybridRouter : "All Requests"
Kong --> SimpleLB : "Direct LB Access"

' === HYBRID ROUTER LOGIC ===
HybridRouter --> LegacySystem : "/pos/produits\n/pos/ventes\n/maisonmere/produits\n/api/v1/*"
HybridRouter --> StockService : "/pos/stock/*"
HybridRouter --> ReportingService : "/maisonmere/reports/*"
HybridRouter --> Produit1 : "/api/v2/produits/*"
HybridRouter --> VenteService : "/api/v2/ventes/*"
HybridRouter --> StockService : "/api/v2/stocks/*"
HybridRouter --> ReportingService : "/api/v2/reports/*"

' === LOAD BALANCER ===
SimpleLB --> Produit1 : "Round-Robin"
SimpleLB --> Produit2 : "Round-Robin"
SimpleLB --> Produit3 : "Round-Robin"

' === DATABASE CONNECTIONS ===
LegacySystem --> MainDB : "Legacy Tables"
VenteService --> MainDB : "Shared Tables"
StockService --> MainDB : "Stock Tables"
ReportingService --> MainDB : "Aggregation"

Produit1 --> ProduitDB : "Dedicated DB"
Produit2 --> ProduitDB : "Dedicated DB"
Produit3 --> ProduitDB : "Dedicated DB"

' === INTER-SERVICE COMMUNICATION ===
VenteService ..> Produit1 : "Product Validation"
VenteService ..> StockService : "Stock Updates"
ReportingService ..> VenteService : "Sales Data"
ReportingService ..> StockService : "Inventory Data"
ReportingService ..> LegacySystem : "Legacy Data"

' === CACHE & MONITORING ===
LegacySystem --> Redis : "Sessions"
ReportingService --> Redis : "Report Cache"
VenteService --> Redis : "Temp Data"

LegacySystem --> Prometheus : "Metrics"
HybridRouter --> Prometheus : "Routing Metrics"
Produit1 --> Prometheus : "Service Metrics"
Produit2 --> Prometheus : "Service Metrics"
Produit3 --> Prometheus : "Service Metrics"
VenteService --> Prometheus : "Service Metrics"
StockService --> Prometheus : "Service Metrics"
ReportingService --> Prometheus : "Service Metrics"

Prometheus --> Grafana : "Data Source"

note top of HybridRouter
  **Routage Intelligent:**
  
  📺 POS Console:
  - Produits → Legacy System
  - Stock → Stock Microservice
  - Ventes → Legacy System
  
  🏢 Maison Mère:
  - Produits → Legacy System
  - Reports → Reporting Microservice
  - Ventes → Legacy System
  
  🚀 API v2:
  - Tous → Microservices
  
  🔄 API v1:
  - Tous → Legacy System
end note

note top of LegacySystem
  **Système de Base (Conservé):**
  - Gestion des magasins
  - Gestion des utilisateurs
  - Sessions et authentification
  - Logique métier existante
  - Compatible avec consoles POS/Maison Mère
end note

note top of ProduitCluster
  **Microservice Produit:**
  - 3 instances load-balanced
  - Base PostgreSQL dédiée
  - API moderne REST
  - Health checks
  - Metrics intégrées
end note

note bottom of MainDB
  **Base de Données Hybride:**
  
  **Tables Legacy (Système de base):**
  - magasins, utilisateurs, sessions
  
  **Tables Partagées:**
  - ventes (legacy + microservice)
  - stocks (principalement microservice)
  
  **Tables Microservices:**
  - rapports_cache, métriques_quotidiennes
end note

note right of StockService
  **Stock en Temps Réel:**
  - Utilisé par POS pour stock live
  - Ajustements automatiques
  - Alertes de seuils
  - Intégration avec ventes
end note

note right of ReportingService
  **Rapports Avancés:**
  - Utilisé par Maison Mère
  - Agrégation multi-sources
  - Analytics avancées
  - Cache intelligent
end note

legend bottom left
  |= Couleur |= Composant |
  | <color:#fff8e1>Jaune</color> | Clients |
  | <color:#e3f2fd>Bleu</color> | API Gateway & Load Balancing |
  | <color:#f3e5f5>Violet</color> | Routeur Hybride |
  | <color:#fff3e0>Orange</color> | Système de Base (Legacy) |
  | <color:#e8f5e8>Vert</color> | Microservices |
  | <color:#ffebee>Rouge</color> | Bases de données |
  | <color:#f5f5f5>Gris</color> | Infrastructure |
  
  **Modes de Routage:**
  • POS → Legacy + Stock μService
  • Maison Mère → Legacy + Reporting μService  
  • API v2 → Tous les μServices
  • API v1 → Legacy uniquement
endlegend

@enduml
