@startuml Vue_Logique
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Vue Logique - Architecture Métier

package "Couche Présentation" {
  component "API Gateway" as gateway {
    interface "REST API" as api
    interface "GraphQL" as graphql
  }
}

package "Couche Métier" {
  
  package "Domaine Produit" {
    component "Catalogue Service" as catalogue
    component "Catégorie Service" as categorie
    component "Prix Service" as prix
  }
  
  package "Domaine Vente" {
    component "Commande Service" as commande
    component "Panier Service" as panier
    component "Facturation Service" as facturation
  }
  
  package "Domaine Stock" {
    component "Inventaire Service" as inventaire
    component "Réservation Service" as reservation
    component "Approvisionnement Service" as approv
  }
  
  package "Domaine Reporting" {
    component "Analytics Service" as analytics
    component "KPI Service" as kpi
    component "Dashboard Service" as dashboard
  }
}

package "Couche Services Transverses" {
  component "Authentification" as auth
  component "Autorisation" as authz
  component "Audit" as audit
  component "Cache" as cache
  component "Notification" as notif
}

package "Couche Données" {
  database "Produits DB" as prod_db
  database "Ventes DB" as vente_db
  database "Stock DB" as stock_db
  database "Legacy DB" as legacy_db
  queue "Message Queue" as mq
}

package "Système Legacy" {
  component "Legacy Adapter" as legacy_adapter
  component "Data Synchronizer" as sync
}

' Relations Présentation -> Métier
gateway --> catalogue
gateway --> commande
gateway --> inventaire
gateway --> analytics

' Relations intra-domaine
catalogue --> categorie
catalogue --> prix
commande --> panier
commande --> facturation
inventaire --> reservation
inventaire --> approv
analytics --> kpi
analytics --> dashboard

' Relations inter-domaines
commande --> catalogue : "vérification produit"
commande --> inventaire : "réservation stock"
facturation --> prix : "calcul prix"
analytics --> commande : "données ventes"
analytics --> inventaire : "données stock"

' Services transverses
gateway --> auth
gateway --> authz
catalogue --> cache
commande --> audit
inventaire --> notif

' Couche données
catalogue --> prod_db
commande --> vente_db
inventaire --> stock_db
legacy_adapter --> legacy_db

' Messaging
commande --> mq : "événements vente"
inventaire --> mq : "événements stock"
analytics --> mq : "consommation événements"

' Legacy
sync --> legacy_adapter
sync --> catalogue : "sync produits"
sync --> inventaire : "sync stock"

note right of gateway
  Point d'entrée unique
  - Routage des requêtes
  - Authentification
  - Rate limiting
  - Transformation protocoles
end note

note right of analytics
  Traitement temps réel
  - Agrégation de données
  - Calcul de KPI
  - Génération rapports
end note

note bottom of mq
  Communication asynchrone
  - Découplage services
  - Garantie de livraison
  - Scalabilité
end note

@enduml
