@startuml Vue_Deploiement
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Deployment.puml

title Vue de Déploiement - Système POS Architecture Production

Deployment_Node(client_tier, "Poste Client", "Magasin") {
  Container(pos_console, "Console POS", "Node.js CLI", "Interface vendeur")
  Container(admin_console, "Console Admin", "Node.js CLI", "Interface gestion")
}

Deployment_Node(gateway_tier, "API Gateway", "Port 9000") {
  Container(gateway, "Hybrid Router", "Node.js:9000", "Routage intelligent + Métriques")
}

Deployment_Node(app_cluster, "Cluster Microservices", "Docker/PM2") {
  Deployment_Node(microservices, "Services Métier") {
    Container(produit, "Service Produit", "Node.js:3001", "Gestion catalogue")
    Container(stock, "Service Stock", "Node.js:3002", "Gestion inventaire")
    Container(vente, "Service Vente", "Node.js:3004", "Traitement ventes")
    Container(reporting, "Service Reporting", "Node.js:3005", "Analytics")
  }
  
  Deployment_Node(legacy_node, "Legacy System") {
    Container(legacy, "Application Legacy", "Node.js:3000", "Support consoles")
  }
}

Deployment_Node(data_cluster, "Stockage Local") {
  Deployment_Node(db_node, "Bases SQLite") {
    ContainerDb(db_produit, "produit.db", "SQLite", "Catalogue produits")
    ContainerDb(db_stock, "stock.db", "SQLite", "Inventaire")
    ContainerDb(db_vente, "vente.db", "SQLite", "Transactions")
    ContainerDb(db_legacy, "legacy.db", "SQLite", "Données partagées")
  }
}

Deployment_Node(monitoring, "Monitoring", "Port 8080") {
  Container(prometheus, "Métriques", "Prometheus", "Collecte métriques")
  Container(dashboard, "Dashboard", "Node.js:8080", "Monitoring temps réel")
}

Deployment_Node(monitoring_cluster, "Monitoring") {
  Container(prometheus, "Prometheus", "Prometheus:9090", "Métriques")
  Container(grafana, "Grafana", "Grafana:3000", "Dashboards")
  Container(node_exporter, "Node Exporter", "Node Exporter:9100", "Métriques système")
}

Deployment_Node(client_zone, "Zone Client") {
  Person(user, "Utilisateur", "Client web/mobile")
}

' Relations
user --> gateway : HTTPS/443
gateway --> produit : HTTP/3001
gateway --> vente : HTTP/3002
gateway --> stock : HTTP/3003
gateway --> reporting : HTTP/3004
gateway --> legacy : HTTP/3005

produit --> db_produit : TCP/5432
vente --> db_vente : TCP/5433
stock --> db_stock : TCP/5434
legacy --> db_legacy : TCP/3306

prometheus --> produit : scrape/metrics
prometheus --> vente : scrape/metrics
prometheus --> stock : scrape/metrics
prometheus --> reporting : scrape/metrics
prometheus --> node_exporter : scrape/9100

grafana --> prometheus : query/9090

@enduml
