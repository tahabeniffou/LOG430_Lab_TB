@startuml Vue_Processus_Sync_Legacy
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Sequence.puml

title Vue Processus - Synchronisation avec Système Legacy

participant "Scheduler" as scheduler
participant "Service Legacy" as legacy
participant "Service Produit" as produit
participant "Service Stock" as stock
participant "Service Vente" as vente
database "DB Legacy" as db_legacy
database "DB Produit" as db_produit
database "DB Stock" as db_stock
database "DB Vente" as db_vente
participant "Message Queue" as mq

== Synchronisation Périodique (toutes les heures) ==

scheduler -> legacy : triggerSync()
activate legacy

legacy -> legacy : startSyncProcess()

' Synchronisation des produits
legacy -> db_legacy : SELECT * FROM products WHERE updated_at > last_sync
db_legacy --> legacy : LegacyProducts

loop Pour chaque produit modifié
  legacy -> legacy : transformProductData(legacyProduct)
  legacy -> produit : updateProduit(transformedData)
  activate produit
  produit -> db_produit : UPDATE produits SET ...
  db_produit --> produit : UpdateOK
  produit --> legacy : ProduitUpdated
  deactivate produit
  
  legacy -> mq : publish(ProduitSynchronized)
end

' Synchronisation du stock
legacy -> db_legacy : SELECT * FROM inventory WHERE updated_at > last_sync
db_legacy --> legacy : LegacyInventory

loop Pour chaque item de stock modifié
  legacy -> legacy : transformStockData(legacyStock)
  legacy -> stock : updateStock(transformedData)
  activate stock
  stock -> db_stock : UPDATE stock SET quantite = ?, updated_at = NOW()
  db_stock --> stock : UpdateOK
  stock --> legacy : StockUpdated
  deactivate stock
  
  legacy -> mq : publish(StockSynchronized)
end

' Synchronisation des ventes (Legacy vers moderne)
legacy -> db_legacy : SELECT * FROM orders WHERE created_at > last_sync
db_legacy --> legacy : LegacyOrders

loop Pour chaque commande legacy
  legacy -> legacy : transformOrderData(legacyOrder)
  legacy -> vente : createHistoricalOrder(transformedData)
  activate vente
  vente -> db_vente : INSERT INTO commandes_historiques
  db_vente --> vente : InsertOK
  vente --> legacy : OrderCreated
  deactivate vente
end

== Synchronisation Temps Réel (événements) ==

note over mq : Événements en temps réel

mq -> legacy : consume(NewCommandeCreated)
legacy -> legacy : transformToLegacyFormat(commande)
legacy -> db_legacy : INSERT INTO orders
db_legacy --> legacy : OrderInserted

mq -> legacy : consume(StockUpdated)
legacy -> legacy : transformToLegacyFormat(stock)
legacy -> db_legacy : UPDATE inventory SET quantity = ?
db_legacy --> legacy : InventoryUpdated

== Gestion des Conflits ==

alt Conflit détecté (même produit modifié simultanément)
  legacy -> legacy : detectConflict(legacyData, modernData)
  legacy -> legacy : applyConflictResolution()
  
  note over legacy
    Stratégie de résolution :
    1. Legacy wins pour les prix
    2. Modern wins pour le stock
    3. Merge pour les descriptions
  end note
  
  legacy -> produit : resolveConflict(resolvedData)
  legacy -> mq : publish(ConflictResolved)
end

== Finalisation ==

legacy -> legacy : updateLastSyncTimestamp()
legacy -> mq : publish(SyncCompleted)

legacy --> scheduler : SyncResult(success, stats)
deactivate legacy

note over scheduler, legacy
  Métriques de synchronisation :
  - Nombre d'éléments synchronisés
  - Conflits résolus
  - Erreurs rencontrées
  - Temps d'exécution
end note

@enduml
