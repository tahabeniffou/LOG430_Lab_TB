@startuml Vue_Cas_Utilisation
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Vue des Cas d'Utilisation - Système E-Commerce

actor "Client Web" as client
actor "Gestionnaire Stock" as manager
actor "Analyste Métier" as analyst
actor "Administrateur" as admin

rectangle "Système Point de Vente (POS)" {
  usecase "Consulter Catalogue" as UC1
  usecase "Traiter Vente" as UC2
  usecase "Gérer Stock" as UC3
  usecase "Analyser Ventes" as UC4
  usecase "Administrer Système" as UC5
  usecase "Générer Rapports" as UC6
  usecase "Console POS" as UC7
  usecase "Console Maison Mère" as UC8
}

rectangle "Système Legacy" as legacy

client --> UC1 : consulte catalogue
client --> UC2 : effectue achat

manager --> UC3 : gère stock
manager --> UC7 : utilise console POS

analyst --> UC4 : analyse
analyst --> UC6 : génère rapports
analyst --> UC8 : console admin

admin --> UC5 : administre
admin --> UC8 : console maison mère

UC7 --> legacy : interface vendeur
UC8 --> legacy : interface admin

note right of UC1
  - Rechercher produits
  - Filtrer par catégorie
  - Consulter détails
end note

note right of UC2
  - Ajouter au panier
  - Valider commande
  - Suivre livraison
end note

note right of UC3
  - Mettre à jour stock
  - Alertes rupture
  - Inventaire
end note

note right of UC4
  - Dashboard ventes
  - Tendances
  - KPI métier
end note

@enduml
