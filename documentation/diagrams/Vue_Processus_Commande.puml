@startuml Vue_Processus_Commande
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Sequence.puml

title Vue Processus - Séquence de Commande

actor Client as client
participant "API Gateway" as gateway
participant "Service Vente" as vente
participant "Service Produit" as produit
participant "Service Stock" as stock
participant "Service Legacy" as legacy
participant "Message Queue" as mq
database "DB Vente" as db_vente
database "DB Stock" as db_stock

client -> gateway : POST /api/commandes
activate gateway

gateway -> gateway : Authentification
gateway -> gateway : Validation token

gateway -> vente : createCommande(produitIds, quantites)
activate vente

' Vérification des produits
vente -> produit : getProduitsDetails(produitIds)
activate produit
produit -> produit : Validation produits
produit --> vente : ProduitsDetails
deactivate produit

' Vérification du stock
vente -> stock : checkDisponibilite(produitIds, quantites)
activate stock
stock -> db_stock : SELECT stock WHERE produit_id IN (...)
db_stock --> stock : StockData
alt Stock suffisant
  stock --> vente : DisponibilitéOK
else Stock insuffisant
  stock --> vente : StockInsuffisant
  vente --> gateway : Erreur stock
  gateway --> client : 400 - Stock insuffisant
  deactivate stock
  deactivate vente
  deactivate gateway
end

' Réservation du stock
vente -> stock : reserverStock(produitIds, quantites)
stock -> db_stock : UPDATE stock SET reserved = reserved + quantite
db_stock --> stock : UpdateOK
stock --> vente : RéservationOK
deactivate stock

' Création de la commande
vente -> vente : calculerTotal(produits, quantites)
vente -> db_vente : INSERT commande
db_vente --> vente : CommandeCreated

' Synchronisation avec le legacy
vente -> legacy : syncCommande(commandeData)
activate legacy
legacy -> legacy : Transform data format
legacy --> vente : SyncOK
deactivate legacy

' Publication d'événements
vente -> mq : publish(CommandeCreated)
vente -> mq : publish(StockReserved)

vente --> gateway : CommandeResponse
deactivate vente

gateway --> client : 201 - Commande créée
deactivate gateway

' Traitement asynchrone
mq -> stock : consume(StockReserved)
activate stock
stock -> db_stock : UPDATE stock SET available = available - quantite
deactivate stock

mq -> legacy : consume(CommandeCreated)
activate legacy
legacy -> legacy : Process commande
legacy -> legacy : Update legacy systems
deactivate legacy

note over vente, stock
  Transaction distribuée avec compensation
  En cas d'échec, annulation automatique
end note

note over mq
  Événements pour traçabilité
  et mise à jour des analytics
end note

@enduml
