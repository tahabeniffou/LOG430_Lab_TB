# Dockerfile pour le routeur hybride
FROM node:18-alpine

# Installer wget pour les health checks
RUN apk add --no-cache wget

WORKDIR /app

# Copier et installer les dépendances du routeur
COPY package-hybrid-router.json ./package.json
RUN npm install --production

# Copier le code du routeur
COPY hybrid-router.js ./

# Variables d'environnement par défaut
ENV NODE_ENV=production
ENV PORT=9000

# Services par défaut (seront surchargés par docker-compose)
ENV PRODUIT_SERVICE_URL=http://localhost:3001
ENV STOCK_SERVICE_URL=http://localhost:3002
ENV VENTE_SERVICE_URL=http://localhost:3004
ENV REPORTING_SERVICE_URL=http://localhost:3005
ENV LEGACY_SERVICE_URL=http://localhost:3000

# Exposer le port
EXPOSE 9000

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:${PORT}/health || exit 1

# Commande de démarrage
CMD ["node", "hybrid-router.js"]
