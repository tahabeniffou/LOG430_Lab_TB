# Variables d'environnement pour déploiement Docker
# LOG430 POS System - Production Environment

# Kong API Gateway
KONG_ADMIN_URL=http://kong:8001
KONG_PROXY_URL=http://kong:8000

# PostgreSQL Produit Service
POSTGRES_PRODUIT_HOST=postgres-produit
POSTGRES_PRODUIT_PORT=5432
POSTGRES_PRODUIT_DB=produit_db
POSTGRES_PRODUIT_USER=produit_user
POSTGRES_PRODUIT_PASSWORD=produit_password

# PostgreSQL Stock Service
POSTGRES_STOCK_HOST=postgres-stock
POSTGRES_STOCK_PORT=5432
POSTGRES_STOCK_DB=stock_db
POSTGRES_STOCK_USER=stock_user
POSTGRES_STOCK_PASSWORD=stock_password

# PostgreSQL Vente Service
POSTGRES_VENTE_HOST=postgres-vente
POSTGRES_VENTE_PORT=5432
POSTGRES_VENTE_DB=vente_db
POSTGRES_VENTE_USER=vente_user
POSTGRES_VENTE_PASSWORD=vente_password

# PostgreSQL Reporting Service
POSTGRES_REPORTING_HOST=postgres-reporting
POSTGRES_REPORTING_PORT=5432
POSTGRES_REPORTING_DB=reporting_db
POSTGRES_REPORTING_USER=reporting_user
POSTGRES_REPORTING_PASSWORD=reporting_password

# Monitoring
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=http://grafana:3000
GRAFANA_ADMIN_PASSWORD=admin

# Application Settings
NODE_ENV=production
LOG_LEVEL=info
