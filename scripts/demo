const axios = require('axios');

class ObservabilityDemo {
    constructor() {
        this.baseUrl = 'http://localhost:8010';
        this.stats = {
            totalRequests: 0,
            successful: 0,
            failed: 0
        };
    }

    async generateLoad() {
        console.log('🚀 ===================================================');
        console.log('  DÉMONSTRATION OBSERVABILITÉ & TRAÇABILITÉ LAB 6');
        console.log('🚀 ===================================================\n');

        // Phase 1: Test de base
        console.log('1️⃣ Phase de base - Quelques sagas pour initialiser...');
        await this.basicLoad(10);
        await this.wait(3000);

        // Phase 2: Test de charge modéré
        console.log('\n2️⃣ Phase de charge modérée - Observons les métriques...');
        await this.moderateLoad(25);
        await this.wait(5000);

        // Phase 3: Test de charge intense
        console.log('\n3️⃣ Phase de charge intense - Générons des données...');
        await this.heavyLoad(50);
        await this.wait(3000);

        // Phase 4: Analyse complète
        console.log('\n4️⃣ Phase d\'analyse - Vérifions l\'observabilité...');
        await this.analyzeObservability();

        console.log('\n🎯 ===================================================');
        console.log('  DÉMONSTRATION TERMINÉE - VÉRIFIEZ VOS DASHBOARDS');
        console.log('🎯 ===================================================');
        console.log('📊 Grafana Dashboard: http://localhost:3000 (admin/admin123)');
        console.log('📈 Prometheus Metrics: http://localhost:9090');
        console.log('🌐 Saga Interface: http://localhost:8010');
        console.log('📝 Logs structurés: saga-orchestrator.log');
        console.log('\n✨ Tous les points d\'observabilité et traçabilité sont maintenant visibles!');
    }

    async basicLoad(count) {
        const promises = [];
        for (let i = 0; i < count; i++) {
            promises.push(this.createSaga({
                articleId: `BASIC_${i.toString().padStart(3, '0')}`,
                quantity: Math.floor(Math.random() * 3) + 1,
                compteId: `BASIC_COMPTE_${i.toString().padStart(3, '0')}`,
                totalAmount: parseFloat((Math.random() * 100 + 25).toFixed(2))
            }));
        }
        
        const results = await Promise.all(promises);
        const successful = results.filter(r => r.success).length;
        console.log(`   ✅ ${successful}/${count} sagas réussies`);
    }

    async moderateLoad(count) {
        const batchSize = 5;
        for (let batch = 0; batch < count / batchSize; batch++) {
            const promises = [];
            
            for (let i = 0; i < batchSize; i++) {
                promises.push(this.createSaga({
                    articleId: `MODERATE_${(batch * batchSize + i).toString().padStart(3, '0')}`,
                    quantity: Math.floor(Math.random() * 5) + 1,
                    compteId: `MOD_COMPTE_${(batch * batchSize + i).toString().padStart(3, '0')}`,
                    totalAmount: parseFloat((Math.random() * 200 + 50).toFixed(2))
                }));
            }
            
            await Promise.all(promises);
            console.log(`   📦 Batch ${batch + 1}/${count / batchSize} terminé`);
            await this.wait(1000); // Pause entre les batches
        }
    }

    async heavyLoad(count) {
        console.log('   🔥 Génération de charge intense...');
        const promises = [];
        
        for (let i = 0; i < count; i++) {
            promises.push(this.createSaga({
                articleId: `HEAVY_${i.toString().padStart(3, '0')}`,
                quantity: Math.floor(Math.random() * 10) + 1,
                compteId: `HEAVY_COMPTE_${i.toString().padStart(3, '0')}`,
                totalAmount: parseFloat((Math.random() * 500 + 100).toFixed(2))
            }));
        }
        
        const startTime = Date.now();
        const results = await Promise.all(promises);
        const duration = Date.now() - startTime;
        const successful = results.filter(r => r.success).length;
        
        console.log(`   ⚡ ${successful}/${count} sagas en ${duration}ms`);
        console.log(`   📊 Throughput: ${(count / duration * 1000).toFixed(2)} req/sec`);
    }

    async createSaga(data) {
        try {
            const response = await axios.post(`${this.baseUrl}/saga/start`, data, {
                timeout: 10000
            });
            
            this.stats.totalRequests++;
            if (response.data.success) {
                this.stats.successful++;
                return { success: true, sagaId: response.data.sagaId };
            } else {
                this.stats.failed++;
                return { success: false, error: response.data.error };
            }
        } catch (error) {
            this.stats.totalRequests++;
            this.stats.failed++;
            return { success: false, error: error.message };
        }
    }

    async analyzeObservability() {
        console.log('   🔍 Analyse des métriques Prometheus...');
        
        try {
            // 1. Métriques de base
            const metrics = await axios.get(`${this.baseUrl}/saga/metrics`);
            console.log('   📊 Métriques générales:');
            console.log(`      • Total sagas: ${metrics.data.total_sagas}`);
            console.log(`      • Taux de succès: ${metrics.data.success_rate}`);
            console.log(`      • Durée moyenne: ${Math.round(metrics.data.avg_duration_ms)}ms`);

            // 2. Événements métiers
            const events = await axios.get(`${this.baseUrl}/saga/business-events`);
            console.log(`   🏢 Événements métiers récents (${events.data.length}):`);
            const eventTypes = {};
            events.data.forEach(event => {
                eventTypes[event.event_type] = (eventTypes[event.event_type] || 0) + 1;
            });
            Object.entries(eventTypes).slice(0, 5).forEach(([type, count]) => {
                console.log(`      • ${type}: ${count} événements`);
            });

            // 3. Transitions d'état
            const transitions = await axios.get(`${this.baseUrl}/saga/state-transitions`);
            console.log(`   🔄 Transitions d'état récentes (${transitions.data.length}):`);
            const transitionTypes = {};
            transitions.data.forEach(transition => {
                const key = `${transition.from_state}→${transition.to_state}`;
                transitionTypes[key] = (transitionTypes[key] || 0) + 1;
            });
            Object.entries(transitionTypes).slice(0, 5).forEach(([type, count]) => {
                console.log(`      • ${type}: ${count} transitions`);
            });

            // 4. Métriques Prometheus brutes
            const promMetrics = await axios.get(`${this.baseUrl}/metrics`);
            const sagaMetrics = promMetrics.data.split('\n').filter(line => 
                line.startsWith('saga_') && !line.startsWith('#') && line.includes('{')
            );
            console.log(`   📈 Métriques Prometheus actives: ${sagaMetrics.length} métriques`);

            // 5. Analytics complètes
            const analytics = await axios.get(`${this.baseUrl}/saga/analytics`);
            console.log('   📋 Analytics complètes disponibles via /saga/analytics');

            console.log('\n   🎯 POINTS D\'OBSERVABILITÉ VÉRIFIÉS:');
            console.log('   ✅ Métriques Prometheus (durée moyenne, échecs, étapes atteintes)');
            console.log('   ✅ Logs structurés avec événements métiers et décisions');
            console.log('   ✅ Visualisation des états via Grafana (dashboards configurés)');
            console.log('   ✅ Traçabilité complète des transactions');

        } catch (error) {
            console.error('   ❌ Erreur lors de l\'analyse:', error.message);
        }
    }

    async wait(ms) {
        return new Promise(resolve => setTimeout(resolve, ms));
    }
}

// Exécuter la démonstration
const demo = new ObservabilityDemo();

// Vérifier que le serveur est accessible
axios.get('http://localhost:8010/health')
    .then(() => {
        console.log('✅ Serveur Saga Orchestrator accessible');
        console.log('🔧 Vérification des services de monitoring...');
        
        // Vérifier Prometheus
        return axios.get('http://localhost:9090/api/v1/query?query=up', { timeout: 5000 });
    })
    .then(() => {
        console.log('✅ Prometheus accessible');
        
        // Vérifier Grafana
        return axios.get('http://localhost:3000/api/health', { timeout: 5000 });
    })
    .then(() => {
        console.log('✅ Grafana accessible');
        console.log('🚀 Démarrage de la démonstration d\'observabilité...\n');
        return demo.generateLoad();
    })
    .catch((error) => {
        if (error.code === 'ECONNREFUSED') {
            if (error.config.url.includes('9090')) {
                console.warn('⚠️  Prometheus non accessible, mais démonstration possible');
            } else if (error.config.url.includes('3000')) {
                console.warn('⚠️  Grafana non accessible, mais démonstration possible');
            } else {
                console.error('❌ Serveur Saga Orchestrator non accessible');
                console.error('   Démarrez le serveur: node saga-orchestrator-prometheus.js');
                return;
            }
        }
        
        console.log('🚀 Démarrage de la démonstration (services partiels)...\n');
        demo.generateLoad();
    });
