{
  "dashboard": {
    "id": null,
    "title": "Kong Gateway & Microservices Monitoring",
    "tags": ["kong", "microservices", "pos"],
    "style": "dark",
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Kong Requests per Second",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(kong_http_requests_total[5m])",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Kong Response Time",
        "type": "graph",
        "targets": [
          {
            "expr": "kong_request_latency",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      },
      {
        "id": 3,
        "title": "Microservices Health",
        "type": "table",
        "targets": [
          {
            "expr": "up{job=~\".*-service.*\"}",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8}
      },
      {
        "id": 4,
        "title": "Load Balancer Distribution",
        "type": "piechart",
        "targets": [
          {
            "expr": "kong_upstream_target_health",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
      },
      {
        "id": 5,
        "title": "System Resource Usage",
        "type": "graph",
        "targets": [
          {
            "expr": "process_resident_memory_bytes",
            "refId": "A"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "5s"
  }
}
