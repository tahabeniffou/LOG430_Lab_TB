{
  "dashboard": {
    "id": null,
    "title": "Architecture Hybride - Comparaison Performance",
    "tags": ["LOG430", "hybride", "performance", "comparison"],
    "style": "dark",
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "📊 Vue d'Ensemble - Temps de Réponse",
        "type": "stat",
        "targets": [
          {
            "expr": "avg(rate(http_request_duration_seconds_sum[5m])) / avg(rate(http_request_duration_seconds_count[5m]))",
            "legendFormat": "Temps de réponse moyen"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 0.5},
                {"color": "red", "value": 1}
              ]
            },
            "unit": "s"
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "🔄 Comparaison Direct vs Gateway - Latence",
        "type": "timeseries",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"hybrid-router\"}[5m]))",
            "legendFormat": "Direct P95"
          },
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"kong-gateway\"}[5m]))",
            "legendFormat": "Gateway P95"
          },
          {
            "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket{job=\"hybrid-router\"}[5m]))",
            "legendFormat": "Direct P50"
          },
          {
            "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket{job=\"kong-gateway\"}[5m]))",
            "legendFormat": "Gateway P50"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "s"
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 6, "y": 0}
      },
      {
        "id": 3,
        "title": "📈 Taux de Requêtes - Direct vs Gateway",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(http_requests_total{job=\"hybrid-router\"}[5m])",
            "legendFormat": "Direct - {{method}} {{status}}"
          },
          {
            "expr": "rate(http_requests_total{job=\"kong-gateway\"}[5m])",
            "legendFormat": "Gateway - {{method}} {{status}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "reqps"
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0}
      },
      {
        "id": 4,
        "title": "❌ Taux d'Erreur - Comparaison",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(http_requests_total{job=\"hybrid-router\",status=~\"5..\"}[5m]) / rate(http_requests_total{job=\"hybrid-router\"}[5m]) * 100",
            "legendFormat": "Direct"
          },
          {
            "expr": "rate(http_requests_total{job=\"kong-gateway\",status=~\"5..\"}[5m]) / rate(http_requests_total{job=\"kong-gateway\"}[5m]) * 100",
            "legendFormat": "Gateway"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 1},
                {"color": "red", "value": 5}
              ]
            },
            "unit": "percent"
          }
        },
        "gridPos": {"h": 6, "w": 8, "x": 0, "y": 8}
      },
      {
        "id": 5,
        "title": "🎯 Routage par Console",
        "type": "piechart",
        "targets": [
          {
            "expr": "sum by (client_type) (rate(http_requests_total{job=\"hybrid-router\"}[5m]))",
            "legendFormat": "{{client_type}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            }
          }
        },
        "gridPos": {"h": 6, "w": 8, "x": 8, "y": 8}
      },
      {
        "id": 6,
        "title": "🔄 Load Balancing - Instances Produit",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(http_requests_total{job=\"produit-service\"}[5m])",
            "legendFormat": "Instance {{instance}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "reqps"
          }
        },
        "gridPos": {"h": 6, "w": 8, "x": 16, "y": 8}
      },
      {
        "id": 7,
        "title": "🏛️ Services Legacy vs Microservices",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(http_requests_total{job=\"legacy-system\"}[5m])",
            "legendFormat": "Legacy System"
          },
          {
            "expr": "rate(http_requests_total{job=\"produit-service\"}[5m])",
            "legendFormat": "Produit Service"
          },
          {
            "expr": "rate(http_requests_total{job=\"vente-service\"}[5m])",
            "legendFormat": "Vente Service"
          },
          {
            "expr": "rate(http_requests_total{job=\"stock-service\"}[5m])",
            "legendFormat": "Stock Service"
          },
          {
            "expr": "rate(http_requests_total{job=\"reporting-service\"}[5m])",
            "legendFormat": "Reporting Service"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "reqps"
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14}
      },
      {
        "id": 8,
        "title": "🔒 Kong Security Metrics",
        "type": "table",
        "targets": [
          {
            "expr": "increase(kong_http_status{job=\"kong-gateway\"}[5m])",
            "legendFormat": "Status {{code}}"
          },
          {
            "expr": "increase(kong_latency_bucket{job=\"kong-gateway\"}[5m])",
            "legendFormat": "Latency {{le}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            }
          }
        },
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14}
      },
      {
        "id": 9,
        "title": "💾 Performance Base de Données",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(mysql_global_status_queries[5m])",
            "legendFormat": "MySQL Queries/sec"
          },
          {
            "expr": "rate(pg_stat_database_tup_fetched[5m])",
            "legendFormat": "PostgreSQL Tuples/sec"
          },
          {
            "expr": "redis_connected_clients",
            "legendFormat": "Redis Connections"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            }
          }
        },
        "gridPos": {"h": 6, "w": 12, "x": 0, "y": 22}
      },
      {
        "id": 10,
        "title": "📊 Tableau Comparatif - Métriques Clés",
        "type": "table",
        "targets": [
          {
            "expr": "avg_over_time(http_request_duration_seconds{quantile=\"0.95\"}[1h])",
            "legendFormat": "Architecture",
            "format": "table"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {},
              "indexByName": {},
              "renameByName": {
                "job": "Architecture",
                "Value": "P95 Latency (s)"
              }
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 0.5},
                {"color": "red", "value": 1}
              ]
            }
          },
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "Architecture"},
              "properties": [
                {
                  "id": "custom.displayMode",
                  "value": "color-text"
                }
              ]
            }
          ]
        },
        "gridPos": {"h": 6, "w": 12, "x": 12, "y": 22}
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {},
    "templating": {
      "list": []
    },
    "annotations": {
      "list": [
        {
          "name": "Deployments",
          "datasource": "prometheus",
          "enable": true,
          "expr": "resets(process_start_time_seconds[1h])",
          "iconColor": "rgba(255, 96, 96, 1)",
          "titleFormat": "Service Restart"
        }
      ]
    },
    "refresh": "5s",
    "schemaVersion": 30,
    "version": 1,
    "links": []
  }
}
