      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "tags": "administrator"
    }
  ],
  "vhosts": [
    {
      "name": "/"
    }
  ],
  "permissions": [
    {
      "user": "admin",
      "vhost": "/",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "topic_permissions": [],
  "parameters": [],
  "global_parameters": [
    {
      "name": "cluster_name",
      "value": "rabbit@pos-system"
    }
  ],
  "policies": [],
  "queues": [
    {
      "name": "reclamations.events",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-message-ttl": 86400000
      }
    },
    {
      "name": "notifications.events",
      "vhost": "/", 
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "audit.events",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "analytics.events",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    }
  ],
  "exchanges": [
    {
      "name": "pos.events",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "reclamations.exchange",
      "vhost": "/",
      "type": "topic", 
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "bindings": [
    {
      "source": "reclamations.exchange",
      "vhost": "/",
      "destination": "reclamations.events",
      "destination_type": "queue",
      "routing_key": "reclamation.*",
      "arguments": {}
    },
    {
      "source": "pos.events",
      "vhost": "/",
      "destination": "notifications.events",
      "destination_type": "queue",
      "routing_key": "*.notification",
      "arguments": {}
    },
    {
      "source": "pos.events",
      "vhost": "/",
      "destination": "audit.events", 
      "destination_type": "queue",
      "routing_key": "*",
      "arguments": {}
    },
    {
      "source": "pos.events",
      "vhost": "/",
      "destination": "analytics.events",
      "destination_type": "queue", 
      "routing_key": "*.analytics",
      "arguments": {}
    }
  ]
}
