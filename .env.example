# Configuration d'environnement pour LOG430 POS
# Copiez ce fichier vers .env et modifiez selon vos besoins

# === Base de données PostgreSQL ===
POSTGRES_DB=posdb
POSTGRES_USER=posuser
POSTGRES_PASSWORD=pospass
POSTGRES_HOST=db

# === Configuration API ===
PORT=3000
NODE_ENV=development

# === CORS - Origines autorisées ===
# Pour le développement: * (toutes les origines)
# Pour la production: https://mondomaine.com,https://app.mondomaine.com
CORS_ORIGINS=*

# === Sécurité ===
# Générez une clé secrète forte pour JWT (si implémenté)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# === Logging ===
LOG_LEVEL=info

# === Monitoring (optionnel) ===
PROMETHEUS_ENABLED=true

# === Features flags (optionnel) ===
ENABLE_SWAGGER=true
ENABLE_REDOC=true
